# --- Backend-only secrets (never expose to frontend) ---
DATABASE_URL=postgres://witnessweave:changeme@localhost:5432/witnessweave
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of origins allowed to call this API (Vercel frontend URL(s))
CORS_ORIGINS=http://localhost:3000

# Session signing secret used to issue backend session tokens after wallet-signature auth
SESSION_JWT_SECRET=replace-with-a-long-random-value

# GenLayer StudioNet RPC + deployed contract address (set after you deploy the contract)
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=

# Evidence file storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dedicated backend-owned wallet the deadline watcher uses to call
# evaluate_bounty/settle/claim_timeout_refund once their deadline passes
# on a bounty nobody's actively watching (see docs/genlayer.md). Contract
# deadlines are real wall-clock timestamps (GenVM patches datetime.now()
# to consensus-agreed block time) — this wallet just pays gas to trigger
# those permissionless calls on a schedule; it never touches escrow funds.
HEARTBEAT_PRIVATE_KEY=
# Optional. How often the watcher checks for passed deadlines (ms). Default: 3 minutes.
DEADLINE_WATCHER_INTERVAL_MS=180000
