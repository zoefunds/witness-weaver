# --- Backend-only secrets (never expose to frontend) ---
DATABASE_URL=postgres://witnessweave:changeme@localhost:5432/witnessweave
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of origins allowed to call this API (Vercel frontend URL(s))
CORS_ORIGINS=http://localhost:3000

# Session signing secret used to issue backend session tokens after wallet-signature auth
SESSION_JWT_SECRET=replace-with-a-long-random-value

# GenLayer StudioNet RPC + deployed contract address (set after you deploy the contract)
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=

# Evidence file storage (Cloudflare R2 / S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=witnessweave-evidence
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
